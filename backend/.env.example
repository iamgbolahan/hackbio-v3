DATABASE_URL=postgresql://hackbio:hackbio@localhost:55440/hackbio
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5500,https://final-nasa-hackathon-2.vercel.app

# Minutes a WATCH value must persist before it escalates to ATTENTION; empty means never escalate.
PERSISTENCE_RESP_RATE_MIN=30
PERSISTENCE_SPO2_MIN=30
PERSISTENCE_SBP_MIN=60
PERSISTENCE_GLUCOSE_MIN=

# Personal-baseline layer: |z| at or above this, sustained, raises WATCH; empty keeps it informational (see README).
BASELINE_Z_LIMIT=
# A gap between consecutive readings longer than this is logged as "no data".
GAP_MINUTES=10
# Bio-Monitor counts as connected if its latest reading is within this many minutes of "now".
CONNECTED_WITHIN_MIN=15

# --- v3: sign-in, Bio-Monitor and simulator ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# DEVICE_API_KEY=change-me   # needed only if a real device gateway posts readings
SIM_ENABLED=true
SIM_DEMO_EPISODES=false
SIM_INTERVAL_SEC=5
MISSION_START_DATE=2026-10-08
